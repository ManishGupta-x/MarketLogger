FROM node:18-slim

# Install Python and build tools for better-sqlite3
RUN apt-get update && apt-get install -y \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy rest of app
COPY . .

# Create data directory
RUN mkdir -p /data

# Expose port
EXPOSE 34000

# Start the app
CMD ["node", "src/app.js"]
