# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Zerodha API Configuration
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=your_access_token_here

# Zerodha Login Credentials (for auto-login)
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_TOTP_SECRET=your_totp_secret

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_LOG_CHANNEL_ID=your_log_channel_id
DISCORD_TICKER_CHANNEL_ID=your_ticker_channel_id
DISCORD_ORDER_CHANNEL_ID=1424357736820379668
CONTROL_PANEL_CHANNEL_ID=your_control_panel_channel_id

# Multi-Channel Trading Configuration
# NEW Combined format (recommended): CHANNEL_X_CONFIG=CHANNEL_ID-NAME-INITIAL_CAPITAL-AMOUNT_PER_TRADE-GRID_PERCENTAGE
# This reduces 5 variables per channel to just 1!

# Channel 1 - Conservative (combined format)
CHANNEL_1_CONFIG=your_channel_1_id-Conservative-100000-5000-5.0

# Channel 2 - Moderate (combined format)
CHANNEL_2_CONFIG=your_channel_2_id-Moderate-50000-2500-7.5

# Channel 3 - Aggressive (combined format)
CHANNEL_3_CONFIG=your_channel_3_id-Aggressive-25000-2000-10.0

# You can add more channels (up to 10) by adding CHANNEL_4_CONFIG, CHANNEL_5_CONFIG, etc.

# Legacy format (still supported for backward compatibility):
# DISCORD_CHANNEL_1_ID=your_channel_1_id
# CHANNEL_1_NAME=Conservative
# CHANNEL_1_INITIAL_CAPITAL=100000
# CHANNEL_1_AMOUNT_PER_TRADE=5000
# CHANNEL_1_GRID_PERCENTAGE=5.0

# Legacy Configuration (for backward compatibility - not used in multi-channel mode)
PAPER_TRADING_ENABLED=false
INITIAL_CAPITAL=500000
AMOUNT_PER_TRADE=10000
GRID_PERCENTAGE=5.0
AUTO_START_TRADING=false

# Optional Configuration
# MAX_POSITIONS_PER_STOCK=5
# DAILY_SUMMARY_TIME=15:30
