# ==========================================
# ZERODHA API CONFIGURATION
# ==========================================

ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_TOTP_SECRET=your_totp_secret
ZERODHA_ACCESS_TOKEN=your_access_token

# ==========================================
# SYSTEM CONFIGURATION
# ==========================================

NODE_ENV=production
TZ=Asia/Kolkata
PORT=4000

# Interface the API binds to. Default 127.0.0.1 (loopback only — reachable via
# a reverse proxy or SSH tunnel). Set 0.0.0.0 to expose directly (not advised).
HOST=127.0.0.1

# When set, every API route except /api/health requires this value in the
# X-API-Key header. Required if the API is reachable from the internet.
# Generate one with: openssl rand -hex 24
API_KEY=

# Comma-separated list of allowed browser origins (the deployed dashboard).
# Unset = allow all (fine for localhost-only use).
CORS_ORIGINS=

# Safety gate: live modes (live_readonly/live_confirm/live_auto) cannot even be
# selected in the broker mode selector unless this is explicitly "true". Note
# that even when unlocked, this build has no live order-placement code — the
# broker integration is read-only (holdings/positions/margins) only.
LIVE_TRADING_UNLOCKED=false

# ==========================================
# NOTIFICATIONS (optional)
# ==========================================

DISCORD_WEBHOOK_URL=

# ==========================================
# FRONTEND
# ==========================================

NEXT_PUBLIC_API_URL=http://localhost:4000
