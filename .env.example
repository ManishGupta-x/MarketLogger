# ==========================================
# ZERODHA API CONFIGURATION
# ==========================================

ZERODHA_API_KEY=your_api_key
ZERODHA_API_SECRET=your_api_secret
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_TOTP_SECRET=your_totp_secret
ZERODHA_ACCESS_TOKEN=your_access_token

# ==========================================
# SYSTEM CONFIGURATION
# ==========================================

NODE_ENV=production
TZ=Asia/Kolkata
PORT=8080
DATABASE_PATH=./data/portfolio.db

# ==========================================
# TRADING MODE
# ==========================================

# Enable paper trading (simulated, no real orders)
PAPER_TRADING_ENABLED=true

# Auto-start trading on server launch
AUTO_START_TRADING=false

# ==========================================
# CAPITAL & POSITION SIZING
# ==========================================

# Total capital for trading
INITIAL_CAPITAL=100000

# Amount to invest per trade
AMOUNT_PER_TRADE=5000

# ==========================================
# GRID STRATEGY (Entry Logic)
# ==========================================

# Drop percentage to trigger a buy (grid level spacing)
GRID_PERCENTAGE=0.25

# ==========================================
# ADAPTIVE TRADING MODE
# ==========================================

# Enable adaptive trading (overrides fixed grid exits)
ADAPTIVE_MODE=true

# ==========================================
# MARKET REGIME DETECTION
# ==========================================

# How often to check market regime (ms)
REGIME_CHECK_FREQUENCY=60000

# EMA periods for trend detection
REGIME_EMA_SHORT=20
REGIME_EMA_LONG=50

# ADX settings (trend strength)
REGIME_ADX_PERIOD=14
REGIME_ADX_THRESHOLD=25

# RSI settings
REGIME_RSI_PERIOD=14
REGIME_RSI_BULLISH=60
REGIME_RSI_BEARISH=40

# Score thresholds for regime classification (0-100)
REGIME_BULLISH_THRESHOLD=60
REGIME_BEARISH_THRESHOLD=60

# Minimum time to hold a regime before switching (ms)
REGIME_HYSTERESIS=300000

# Combined index weights (must sum to 100)
NIFTY_50_WEIGHT=60
NIFTY_BANK_WEIGHT=40

# ==========================================
# STOCK SCREENING
# ==========================================

# Number of top stocks to trade
TOP_STOCKS_COUNT=10

# How often to re-screen stocks (ms)
SCREEN_FREQUENCY=300000

# Minimum price data points required
MIN_PRICE_HISTORY=50

# ==========================================
# ADAPTIVE EXIT: TRAILING STOP
# (Let Winners Run)
# ==========================================

# Profit % required to activate trailing stop
TRAILING_STOP_ACTIVATION=0.5

# Trail distance % below highest price
TRAILING_STOP_DISTANCE=0.3

# Tighten trail as profit grows
TRAILING_STOP_ACCELERATE=true

# ==========================================
# ADAPTIVE EXIT: RAPID DECLINE
# (Cut Losers Quick)
# ==========================================

# Drop % within window to trigger exit
RAPID_DECLINE_THRESHOLD=0.3

# Time window for rapid decline detection (ms)
RAPID_DECLINE_WINDOW=5000

# ==========================================
# ADAPTIVE EXIT: MOMENTUM
# ==========================================

# Enable momentum exhaustion exit
MOMENTUM_EXIT_ENABLED=true

# RSI level to trigger momentum exit
MOMENTUM_EXIT_RSI=80

# ==========================================
# ADAPTIVE EXIT: BACKSTOP
# (Safety Net - Always Active)
# ==========================================

# Maximum loss % per trade (hard stop)
BACKSTOP_STOP_LOSS=2.0

# ==========================================
# PORTFOLIO RISK MANAGEMENT
# ==========================================

# Max daily portfolio drawdown % (halts trading if exceeded)
MAX_DAILY_DRAWDOWN=3.0

# Max % of capital that can be invested at once
MAX_PORTFOLIO_HEAT=80

# Cooldown after drawdown halt (ms) - 1 hour default
DRAWDOWN_COOLDOWN=3600000

# ==========================================
# SECTOR DIVERSIFICATION
# ==========================================

# Enable sector limits
SECTOR_DIVERSIFICATION=true

# Maximum stocks per sector
SECTOR_LIMIT_BANKING=2
SECTOR_LIMIT_IT=2
SECTOR_LIMIT_PHARMA=2
SECTOR_LIMIT_AUTO=2
SECTOR_LIMIT_FMCG=2
SECTOR_LIMIT_ENERGY=2
SECTOR_LIMIT_METAL=2
SECTOR_LIMIT_INFRA=2
SECTOR_LIMIT_NBFC=2
SECTOR_LIMIT_TELECOM=1
SECTOR_LIMIT_REALTY=1
SECTOR_LIMIT_CONSUMER=2
SECTOR_LIMIT_CHEMICAL=2

# ==========================================
# GAP OPENING HANDLING
# ==========================================

# Gap % from previous close to trigger gap handling
GAP_THRESHOLD=1.0

# Pause trailing stops after gap (ms) - 2 min default
GAP_PAUSE_DURATION=120000

# Widen stop by this % after gap opening
GAP_STOP_ADJUST=0.5

# ==========================================
# SLIPPAGE & IMPACT COST SIMULATION
# ==========================================

# Base slippage for all orders (%)
BASE_SLIPPAGE=0.05

# Additional slippage for exit orders (%)
EXIT_SLIPPAGE=0.05

# Slippage multiplier during high volatility
SLIPPAGE_VOLATILITY_MULT=1.5

# Impact cost per lakh of order value (%)
IMPACT_COST_PER_LAKH=0.02

# Maximum total slippage cap (%)
MAX_SLIPPAGE=0.3
