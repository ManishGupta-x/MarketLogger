# Zerodha API Configuration
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=your_access_token_here

# Zerodha Login Credentials (for auto-login)
ZERODHA_USER_ID=your_user_id
ZERODHA_PASSWORD=your_password
ZERODHA_TOTP_SECRET=your_totp_secret

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_LOG_CHANNEL_ID=your_log_channel_id
DISCORD_TICKER_CHANNEL_ID=your_ticker_channel_id

# Paper Trading Configuration
PAPER_TRADING_ENABLED=false
INITIAL_CAPITAL=500000
AMOUNT_PER_TRADE=10000
GRID_PERCENTAGE=5.0

# Optional Configuration
# MAX_POSITIONS_PER_STOCK=5
# AUTO_START_TRADING=false
# DAILY_SUMMARY_TIME=15:30
